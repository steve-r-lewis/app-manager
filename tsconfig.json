{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "#imports": [
        ".nuxt/imports.d.ts"
      ]
    }
  },
  "include": [
	  "index.ts",
	  "app/**/*",
	  "tests/**/*",
    "**/*.ts"
  ],
	"exclude": [
		"node_modules",
		"dist",
		"tests/fixtures",
		"**/*.spec.ts",
		"**/*.test.ts"
	]
}