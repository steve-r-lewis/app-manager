{
  "name": "app-manager",
  "version": "1.0.0",
  "description": "A Typescript based application to manage the codebase source code for my Nuxt4 based projects",
  "private": true,
  "main": "app/index.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "administration",
    "application code manager",
    "typescript"
  ],
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "volta": {
    "node": "20.12.0",
    "pnpm": "11.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steve-r-lewis/app-manager.git"
  },
  "bugs": {
    "url": "https://github.com/steve-r-lewis/app-manager/issues"
  },
  "authors": [
    {
      "name": "Steve R Lewis",
      "email": "me@steve-lewis.uk",
      "url": "https://www.steve-lewis.uk"
    }
  ],
  "funding": {
    "type": "individual",
    "url": "patreon.com/TheModuleFactory"
  },
  "bin": {
    "app-manager": "app/index.ts"
  },
  "scripts": {
    "vitest:run": "vitest run",
    "vitest:unit": "vitest run tests/unit",
    "vitest:e2e": "vitest run tests/e2e --test-timeout=30000",
    "vitest:watchUnit": "vitest tests/unit",
    "vitest:watchAll": "vitest",
    "vitest:coverage": "vitest run --coverage",
    "vitest:ui": "vitest --ui",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@google/generative-ai": "^0.24.1",
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "simple-git": "^3.30.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/ui": "^4.0.16",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "2.0.0-alpha.15",
    "vitest": "^4.0.15"
  },
  "contributors": [
    {
      "name": "Gemini Pro",
      "email": "donotreply@gmail.com"
    }
  ]
}